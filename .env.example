# --- Postgres ---
DATABASE_URL=postgres://astrolabe:astrolabe@localhost:5433/astrolabe

# --- apps/api ---
PORT=4000
NODE_ENV=development
# Exact origin allowed by CORS to send credentialed requests (cookie-based
# session auth needs an exact match, not '*').
WEB_ORIGIN=http://localhost:3000

# JWT (HS256, single process — see docs/adr/0002-jwt-signing-algorithm.md)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=astrolabe-api
JWT_AUDIENCE=astrolabe-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Argon2id (module: auth)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Account lockout (module: auth)
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_WINDOW_MINUTES=15

# Embeddings (packages/inference — separate endpoint, typically a dedicated
# embedding server rather than the chat/judge model below). OpenAI-compatible
# /v1/embeddings (LOCAL_LLM_EMBEDING_URI>:PORT TEI shim, or any compatible host).
EMBEDDING_API_URL=http://<LOCAL_LLM_EMBEDING_URI>:PORT
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Master switch for external AI services (score + stream, packages/inference).
# Set to false to disable both without clearing INFERENCE_API_URL below.
USE_EXTERNAL_AI=true

# Inference provider (packages/inference) — OpenAI-compatible chat completions
# endpoint. Named after the capability, not a specific provider: cahier des
# charges §4.6 acts an interchangeable provider by configuration — dev on a
# local server (e.g. llama.cpp), prod on an EU-hosted provider.
INFERENCE_API_URL=http://LOCAL_LLM_INFERENCE_URI>:PORT
INFERENCE_API_KEY=
INFERENCE_MODEL_GENERATION=LLM_MODEL_GENERATION_NAME
# Optional LLM-judge when RERANKER_API_URL is blank (ADR 0004).
INFERENCE_MODEL_JUDGE=

# TEI /rerank endpoint — preferred by InferenceClient.score when set.
RERANKER_API_URL=http://<LOCAL_LLM_RERANKER_URI>:PORT

# Reranking (module: retrieval) — default false in ADR 0004; enable once a
# reranker (TEI or judge model) is reachable.
RERANK_ENABLED=true
FUSION_METHOD=rrf

# Local directory for uploaded PDF/DOCX bytes pending processJob.
UPLOAD_DIR=.data/uploads

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
